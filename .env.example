STEAM_API_KEY="your key"
STEAM_API_KEY_2="another key to manage request limit"
CHEATER_AI_API_BASE="render_url"
RESEND_API_KEY="resend key"
FEEDBACK_RESEND_EMAIL="you@example.com"
FACEIT_API_KEY="your key"
GAMERSCLUB_SESSION_COOKIE="your token"
# Cloudflare challenge-pass, WITHOUT which every GC request 403s at the edge
# ("Just a moment..."). Copy `cf_clearance` from a logged-in browser session.
# COUPLED to the User-Agent below: Cloudflare binds the clearance to the
# exact UA that solved the challenge — refresh/rotate both together, or the
# scraper 403s again. The proxy/smoke fail fast when this is missing.
GAMERSCLUB_CF_CLEARANCE="your clearance token"
# Optional override for the UA sent with GC requests. Defaults to the Edge UA
# the clearance above was solved with — only set this when refreshing the
# clearance from a browser with a different UA (keep them in sync!).
# IP STABILITY WARNING: Cloudflare also binds the clearance to the egress IP
# that solved the challenge. This scraper runs on the standalone local proxy
# (start:proxy-local, NOT serverless), so refresh the clearance from a
# browser on the SAME machine/network that runs the proxy — a clearance
# solved elsewhere (or behind a rotating egress IP) 403s even when fresh.
# (Kept commented on purpose: an uncommented placeholder here would send a
# literal invalid UA and 403 every request.)
# GAMERSCLUB_USER_AGENT="your browser user-agent"
GC_SMOKE_ACTIVE_STEAM_ID=""
GC_SMOKE_BANNED_STEAM_ID=""
LOCAL_PROXY_URL=""
LOCAL_PROXY_PORT="3001"
ANALYTICS_SKIP_PASSWORD="a-secure-password-here"
ANALYTICS_DASHBOARD_PASSWORD="another-secure-password-here"
DATABASE_URL=""
DATABASE_TOKEN=""